# Copy into the prepared source directory as .env, chmod 0600, and replace
# secret placeholders with fresh random values. Never commit the populated file.
# Build mirrors (non-secret; the app Dockerfile applies its Debian mirror before
# the first apt index request).
APK_MIRROR_ARG=mirrors.tuna.tsinghua.edu.cn
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn
GOPROXY_ARG=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
WEKNORA_VERSION=cnz-dev-v0.9.1
FRONTEND_PORT=127.0.0.1:18082
APP_PORT=127.0.0.1:39301
APP_BACKEND_PORT=8080
APP_HOST=app
GIN_MODE=release
TZ=Asia/Shanghai
LOG_LEVEL=info
DISABLE_REGISTRATION=true
WEKNORA_AUTH_COMPLEX_PASSWORD_ENABLED=true
WEKNORA_AUTH_DEFAULT_TENANT_MODE=tenantless
WEKNORA_TENANT_SELF_SERVICE_CREATION_ENABLED=false
WEKNORA_TENANT_ENABLE_CROSS_TENANT_ACCESS=false
WEKNORA_SANDBOX_DOCKER_ENABLED=false
AUTO_MIGRATE=true
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=cnz_weknora
DB_PASSWORD=REPLACE_WITH_GENERATED_RANDOM_SECRET
DB_NAME=cnz_weknora
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_GENERATED_RANDOM_SECRET
OIDC_AUTH_ENABLE=false
OIDC_AUTH_PKCE_ENABLED=true
OIDC_AUTH_ISSUER_URL=
OIDC_AUTH_CLIENT_ID=
OIDC_AUTH_CLIENT_SECRET=
OIDC_AUTH_JWKS_URI=
OIDC_AUTH_USER_INFO_ENDPOINT=
OIDC_AUTH_SCOPES=openid profile email
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
