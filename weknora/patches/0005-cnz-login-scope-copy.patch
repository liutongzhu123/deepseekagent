diff --git a/frontend/src/config/cnzLoginProfile.test.ts b/frontend/src/config/cnzLoginProfile.test.ts
new file mode 100644
index 0000000..d6ecdab
--- /dev/null
+++ b/frontend/src/config/cnzLoginProfile.test.ts
@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import auth from '../i18n/locales/zh-CN/auth'
+import common from '../i18n/locales/zh-CN/common'
+
+test('CNZ login describes project knowledge administration only', () => {
+  assert.equal(auth.auth.subtitle, '中汽零部件知识库管理入口')
+  assert.equal(common.platform.subtitle, '中汽零部件知识管理平台')
+  assert.equal(common.platform.carousel.cnzKnowledgeTitle, '项目知识资料')
+  assert.match(common.platform.carousel.cnzKnowledgeDesc, /资料解析、混合检索与来源引用/)
+  assert.doesNotMatch(auth.auth.subtitle, /ReAct|Wiki/)
+  assert.doesNotMatch(common.platform.description, /智能体|Wiki/)
+})
