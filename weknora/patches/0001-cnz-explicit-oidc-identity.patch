+			name:       "bind",
+			method:     "PUT",
+			body:       `{"user_id":"target-1","subject":"subject-1"}`,
+			handler:    func(h *SystemHandler, c *gin.Context) { h.BindOIDCIdentity(c) },
+			auditEvent: types.AuditActionSystemUserOIDCIdentityBindingRequested,
+		},
+		{
+			name:       "unbind",
+			method:     "DELETE",
+			body:       `{"user_id":"target-1"}`,
+			handler:    func(h *SystemHandler, c *gin.Context) { h.UnbindOIDCIdentity(c) },
+			auditEvent: types.AuditActionSystemUserOIDCIdentityUnbindingRequested,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			audits := &capturingAuditService{logErr: errors.New("audit storage unavailable")}
+			users := &oidcBindingUserServiceStub{target: &types.User{ID: "target-1"}}
+			h := &SystemHandler{userSvc: users, auditSvc: audits}
+			req := httptest.NewRequest(tc.method, "/api/v1/system/admin/users/oidc-binding", strings.NewReader(tc.body))
+			recorder := httptest.NewRecorder()
