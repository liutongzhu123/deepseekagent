+package repository
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/require"
+	"gorm.io/driver/sqlite"
+	"gorm.io/gorm"
+)
+
+func TestOIDCIdentityRequiresExplicitUniqueBinding(t *testing.T) {
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "users.db")), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&types.User{}))
+	require.NoError(t, db.Exec("DROP INDEX IF EXISTS idx_users_oidc_identity").Error)
+	migration, err := os.ReadFile(filepath.Join("..", "..", "..", "migrations", "sqlite", "000054_users_oidc_identity.up.sql"))
+	require.NoError(t, err)
+	require.NoError(t, db.Exec(string(migration)).Error)
+	repo := NewUserRepository(db).(*userRepository)
+	ctx := context.Background()
+	for _, id := range []string{"user-a", "user-b"} {
+		require.NoError(t, repo.CreateUser(ctx, &types.User{
+			ID: id, Username: id, Email: id + "@example.com", PasswordHash: "hash",
+		}))
+	}
+	if _, err := repo.GetUserByOIDCIdentity(ctx, "https://idp.example", "subject-1"); err != ErrUserNotFound {
+		t.Fatalf("unbound identity lookup error = %v, want ErrUserNotFound", err)
+	}
+	issuer, subject := "https://idp.example", "subject-1"
+	require.NoError(t, repo.SetOIDCIdentity(ctx, "user-a", &issuer, &subject))
+	got, err := repo.GetUserByOIDCIdentity(ctx, issuer, subject)
+	require.NoError(t, err)
+	require.Equal(t, "user-a", got.ID)
+	if err := repo.SetOIDCIdentity(ctx, "user-b", &issuer, &subject); err == nil {
+		t.Fatal("duplicate OIDC identity was assigned to a second account")
+	}
+	require.NoError(t, repo.SetOIDCIdentity(ctx, "user-a", nil, nil))
+	if _, err := repo.GetUserByOIDCIdentity(ctx, issuer, subject); err != ErrUserNotFound {
+		t.Fatalf("unbound identity lookup error = %v, want ErrUserNotFound", err)
+	}
+}
+}
