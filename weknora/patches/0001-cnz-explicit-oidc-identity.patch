@@ -0,0 +1,24 @@
+package types
+
+import (
+	"sync"
+	"testing"
+
+	"gorm.io/gorm/schema"
+)
+
+func TestUserOIDCFieldsMatchVersionedMigrationColumns(t *testing.T) {
+	parsed, err := schema.Parse(&User{}, &sync.Map{}, schema.NamingStrategy{})
+	if err != nil {
+		t.Fatalf("parse User schema: %v", err)
+	}
+	for _, field := range []struct{ name, column string }{
+		{name: "OIDCIssuer", column: "oidc_issuer"},
+		{name: "OIDCSubject", column: "oidc_subject"},
+	} {
+		got := parsed.LookUpField(field.name)
+		if got == nil || got.DBName != field.column {
+			t.Errorf("%s DBName = %v, want %s", field.name, got, field.column)
+		}
+	}
+}
