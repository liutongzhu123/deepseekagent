+func (s *userService) SetOIDCIdentity(ctx context.Context, userID string, subject *string) error {
+	cfg, err := s.getOIDCConfig(ctx)
+	if err != nil {
+		return err
+	}
+	issuer := strings.TrimSpace(cfg.IssuerURL)
+	if issuer == "" {
+		return errors.New("OIDC issuer is not configured")
+	}
+	if subject != nil {
+		*subject = strings.TrimSpace(*subject)
+		if *subject == "" || len(*subject) > 255 {
+			return errors.New("OIDC subject must contain 1-255 characters")
+		}
+	}
