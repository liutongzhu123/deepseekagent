+-- OIDC login is matched on verified (issuer, subject), after an administrator
+-- explicitly binds the identity. Multiple unbound users remain valid.
+ALTER TABLE users ADD COLUMN IF NOT EXISTS oidc_issuer VARCHAR(500);
+ALTER TABLE users ADD COLUMN IF NOT EXISTS oidc_subject VARCHAR(255);
+CREATE UNIQUE INDEX IF NOT EXISTS idx_users_oidc_identity
+    ON users (oidc_issuer, oidc_subject)
+    WHERE oidc_issuer IS NOT NULL AND oidc_subject IS NOT NULL;
