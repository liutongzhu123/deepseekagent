+
+func TestOIDCIdentityBindingAuditsRequestBeforeMutation(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	var audits *capturingAuditService
+	users := &oidcBindingUserServiceStub{
+		target: &types.User{ID: "target-1"},
+		onSet: func() {
+			if len(audits.entries) == 0 || audits.entries[0].Action != types.AuditActionSystemUserOIDCIdentityBindingRequested {
+				t.Error("identity mutation started before the request audit was stored")
+			}
+		},
+	}
+	audits = &capturingAuditService{}
+	h := &SystemHandler{userSvc: users, auditSvc: audits}
+	req := httptest.NewRequest("PUT", "/api/v1/system/admin/users/oidc-binding", strings.NewReader(`{"user_id":"target-1","subject":"subject-1"}`))
+	recorder := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(recorder)
+	c.Request = req
+
+	h.BindOIDCIdentity(c)
+
+	if recorder.Code != 200 {
+		t.Fatalf("response status = %d, want 200: %s", recorder.Code, recorder.Body.String())
+	}
+	if users.setCall != 1 {
+		t.Fatalf("identity mutation calls = %d, want 1", users.setCall)
+	}
+	if len(audits.entries) != 2 || audits.entries[1].Action != types.AuditActionSystemUserOIDCIdentityBound {
+		t.Fatalf("audit entries = %#v, want request then completion", audits.entries)
+	}
+}
