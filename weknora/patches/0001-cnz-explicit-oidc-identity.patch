+// GetUserByOIDCIdentity resolves only explicitly bound identities. It does
+// not fall back to email, because email is mutable profile data.
+func (r *userRepository) GetUserByOIDCIdentity(ctx context.Context, issuer, subject string) (*types.User, error) {
+	var user types.User
+	err := r.db.WithContext(ctx).Where("oidc_issuer = ? AND oidc_subject = ?", issuer, subject).First(&user).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, ErrUserNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &user, nil
+}
+
+// SetOIDCIdentity assigns or removes an OIDC identity on an existing account.
+// A database unique constraint prevents concurrent binding to two accounts.
+func (r *userRepository) SetOIDCIdentity(ctx context.Context, userID string, issuer, subject *string) error {
+	if (issuer == nil) != (subject == nil) {
+		return errors.New("issuer and subject must both be set or both be cleared")
+	}
+	updates := map[string]interface{}{"oidc_issuer": issuer, "oidc_subject": subject}
+	result := r.db.WithContext(ctx).Model(&types.User{}).Where("id = ?", userID).Updates(updates)
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected == 0 {
+		return ErrUserNotFound
+	}
+	return nil
+}
