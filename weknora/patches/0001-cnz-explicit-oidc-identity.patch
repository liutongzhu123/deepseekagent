+type oidcIdentityBindingService interface {
+	SetOIDCIdentity(ctx context.Context, userID string, subject *string) error
+}
+
+type oidcIdentityBindingRequest struct {
+	UserID  string `json:"user_id" binding:"required"`
+	Subject string `json:"subject" binding:"required"`
+}
+
+// BindOIDCIdentity explicitly links one existing local account to the
+// configured OIDC provider's stable subject. Email is not accepted here.
+func (h *SystemHandler) BindOIDCIdentity(c *gin.Context) {
+	var req oidcIdentityBindingRequest
+	if err := c.ShouldBindJSON(&req); err != nil || strings.TrimSpace(req.UserID) == "" || strings.TrimSpace(req.Subject) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "user_id and subject are required"})
+		return
+	}
+	binder, ok := h.userSvc.(oidcIdentityBindingService)
+	if !ok {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "OIDC identity binding is unavailable"})
+		return
+	}
+	ctx := logger.CloneContext(c.Request.Context())
+	userID := strings.TrimSpace(req.UserID)
+	target, err := h.userSvc.GetUserByID(ctx, userID)
+	if err != nil {
+		c.JSON(http.StatusConflict, gin.H{"error": "Failed to bind OIDC identity"})
+		return
+	}
+	if err := h.writeAdminAudit(ctx, types.AuditActionSystemUserOIDCIdentityBindingRequested, target, map[string]any{"provider": "configured_oidc"}); err != nil {
+		logger.Errorf(ctx, "Failed to audit OIDC identity binding request for user %s: %v", secutils.SanitizeForLog(userID), err)
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "Unable to record identity binding request"})
+		return
+	}
+	subject := strings.TrimSpace(req.Subject)
+	if err := binder.SetOIDCIdentity(ctx, userID, &subject); err != nil {
+		logger.Errorf(c.Request.Context(), "Failed to bind OIDC identity for user %s: %v", secutils.SanitizeForLog(req.UserID), err)
+		c.JSON(http.StatusConflict, gin.H{"error": "Failed to bind OIDC identity"})
+		return
+	}
+	h.emitAdminAudit(ctx, types.AuditActionSystemUserOIDCIdentityBound, target, map[string]any{"provider": "configured_oidc"})
+	c.JSON(http.StatusOK, gin.H{"success": true, "user_id": userID})
+}
+
+// UnbindOIDCIdentity removes the configured provider identity from an
+// existing account. Password login and all local roles remain unchanged.
+func (h *SystemHandler) UnbindOIDCIdentity(c *gin.Context) {
+	var req struct {
+		UserID string `json:"user_id" binding:"required"`
+	}
+	if err := c.ShouldBindJSON(&req); err != nil || strings.TrimSpace(req.UserID) == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "user_id is required"})
+		return
+	}
+	binder, ok := h.userSvc.(oidcIdentityBindingService)
+	if !ok {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "OIDC identity binding is unavailable"})
+		return
+	}
+	ctx := logger.CloneContext(c.Request.Context())
+	userID := strings.TrimSpace(req.UserID)
+	target, err := h.userSvc.GetUserByID(ctx, userID)
+	if err != nil {
+		c.JSON(http.StatusConflict, gin.H{"error": "Failed to unbind OIDC identity"})
+		return
+	}
+	if err := h.writeAdminAudit(ctx, types.AuditActionSystemUserOIDCIdentityUnbindingRequested, target, map[string]any{"provider": "configured_oidc"}); err != nil {
+		logger.Errorf(ctx, "Failed to audit OIDC identity unbinding request for user %s: %v", secutils.SanitizeForLog(userID), err)
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "Unable to record identity unbinding request"})
+		return
+	}
+	if err := binder.SetOIDCIdentity(ctx, userID, nil); err != nil {
+		logger.Errorf(c.Request.Context(), "Failed to unbind OIDC identity for user %s: %v", secutils.SanitizeForLog(req.UserID), err)
+		c.JSON(http.StatusConflict, gin.H{"error": "Failed to unbind OIDC identity"})
+		return
+	}
+	h.emitAdminAudit(ctx, types.AuditActionSystemUserOIDCIdentityUnbound, target, map[string]any{"provider": "configured_oidc"})
+	c.JSON(http.StatusOK, gin.H{"success": true, "user_id": userID})
+}
