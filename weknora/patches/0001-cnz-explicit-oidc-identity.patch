+	})
+	if !ok {
+		return errors.New("explicit OIDC identity bindings are not available")
+	}
+	var issuerValue *string
+	if subject != nil {
+		issuerValue = &issuer
+	}
+	return repo.SetOIDCIdentity(ctx, userID, issuerValue, subject)
+}
