+package service
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/config"
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/Tencent/WeKnora/internal/types/interfaces"
+)
+
+type oidcFlowUserRepo struct {
+	interfaces.UserRepository
+	user    *types.User
+	issuer  string
+	subject string
+	lookups int
+}
+
+func (r *oidcFlowUserRepo) GetUserByOIDCIdentity(_ context.Context, issuer, subject string) (*types.User, error) {
+	r.lookups++
+	if r.user == nil || issuer != r.issuer || subject != r.subject {
+		return nil, errors.New("user not found")
+	}
+	return r.user, nil
+}
+
+type oidcFlowTokenRepo struct {
+	interfaces.AuthTokenRepository
+	tokens []*types.AuthToken
+}
+
+func (r *oidcFlowTokenRepo) CreateToken(_ context.Context, token *types.AuthToken) error {
+	r.tokens = append(r.tokens, token)
+	return nil
+}
+
+func TestOIDCServiceSyntheticProviderBoundIdentityAndUnboundSameEmail(t *testing.T) {
+	withOIDCSSRFWhitelist(t, "127.0.0.1")
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const issuer = "https://idp.example"
+	const subject = "stable-subject-17"
+	const callback = "https://weknora.example/api/v1/auth/oidc/callback"
+	var codeChallenge string
+	var endpointHits struct {
+		sync.Mutex
+		userinfo int
+		jwks     int
+	}
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/authorize":
+			w.WriteHeader(http.StatusNoContent)
+		case "/token":
+			if err := r.ParseForm(); err != nil {
+				t.Errorf("parse token request: %v", err)
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			verifier := r.Form.Get("code_verifier")
+			endpointHits.Lock()
+			expectedChallenge := codeChallenge
+			endpointHits.Unlock()
+			if r.Form.Get("code") != "synthetic-code" ||
+				r.Form.Get("client_id") != "weknora-client" ||
+				r.Form.Get("redirect_uri") != callback ||
+				r.Form.Get("grant_type") != "authorization_code" ||
+				!matchesPKCES256(expectedChallenge, verifier) {
+				t.Errorf("token request did not match authorization request: %v", r.Form)
+				w.WriteHeader(http.StatusBadRequest)
+				return
+			}
+			claims := baseClaims(issuer, "weknora-client")
+			claims["sub"] = subject
+			idToken := signedIDToken(t, key, "synthetic-kid", claims)
+			_ = json.NewEncoder(w).Encode(map[string]string{
+				"access_token": "synthetic-access-token",
+				"id_token":     idToken,
+				"token_type":   "Bearer",
+			})
+		case "/userinfo":
+			endpointHits.Lock()
+			endpointHits.userinfo++
+			endpointHits.Unlock()
+			if r.Header.Get("Authorization") != "Bearer synthetic-access-token" {
+				t.Errorf("userinfo missing bearer token")
+				w.WriteHeader(http.StatusUnauthorized)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(map[string]string{
+				"sub": subject, "email": "same@example.test", "name": "Synthetic User",
+			})
+		case "/jwks":
+			endpointHits.Lock()
+			endpointHits.jwks++
+			endpointHits.Unlock()
+			_ = json.NewEncoder(w).Encode(oidcJWKS{Keys: []oidcJWK{rsaJWK(key, "synthetic-kid")}})
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	for _, bound := range []bool{true, false} {
+		t.Run(map[bool]string{true: "explicit_binding", false: "same_email_without_binding"}[bound], func(t *testing.T) {
+			endpointHits.Lock()
+			endpointHits.userinfo, endpointHits.jwks = 0, 0
+			endpointHits.Unlock()
+			var boundUser *types.User
+			if bound {
+				boundUser = &types.User{ID: "account-42", Username: "staff", Email: "same@example.test", IsActive: true}
+			}
+			userRepo := &oidcFlowUserRepo{user: boundUser, issuer: issuer, subject: subject}
+			tokenRepo := &oidcFlowTokenRepo{}
+			svc := &userService{
+				userRepo:  userRepo,
+				tokenRepo: tokenRepo,
+				config: &config.Config{OIDCAuth: &config.OIDCAuthConfig{
+					Enable: true, PKCEEnabled: true, IssuerURL: issuer,
+					ClientID: "weknora-client", ClientSecret: "synthetic-client-secret",
+					AuthorizationEndpoint: server.URL + "/authorize",
+					TokenEndpoint:         server.URL + "/token",
+					UserInfoEndpoint:      server.URL + "/userinfo",
+					JwksURI:               server.URL + "/jwks",
+					Scopes:                []string{"openid", "profile", "email"},
+				}},
+			}
+
+			authorization, err := svc.GetOIDCAuthorizationURL(context.Background(), callback)
+			if err != nil {
+				t.Fatalf("build authorization URL: %v", err)
+			}
+			parsedAuthorization, err := url.Parse(authorization.AuthorizationURL)
+			if err != nil {
+				t.Fatal(err)
+			}
+			params := parsedAuthorization.Query()
+			if params.Get("client_id") != "weknora-client" || params.Get("redirect_uri") != callback || params.Get("code_challenge_method") != "S256" {
+				t.Fatalf("unexpected authorization parameters: %v", params)
+			}
+			endpointHits.Lock()
+			codeChallenge = params.Get("code_challenge")
+			endpointHits.Unlock()
+
+			response, err := svc.LoginWithOIDC(context.Background(), "synthetic-code", callback, types.TenantProvisioningMode(""), authorization.PKCEVerifier)
+			if bound {
+				if err != nil || response == nil || !response.Success || response.IsNewUser || response.User.ID != "account-42" {
+					t.Fatalf("bound identity did not login: response=%+v err=%v", response, err)
+				}
+				if userRepo.lookups != 1 || len(tokenRepo.tokens) != 2 {
+					t.Fatalf("expected one identity lookup and two persisted tokens, lookups=%d tokens=%d", userRepo.lookups, len(tokenRepo.tokens))
+				}
+			} else {
+				if err == nil || !strings.Contains(err.Error(), "not bound") || response != nil {
+					t.Fatalf("same-email unbound identity must be denied: response=%+v err=%v", response, err)
+				}
+				if userRepo.lookups != 1 || len(tokenRepo.tokens) != 0 {
+					t.Fatalf("unbound identity must not issue tokens, lookups=%d tokens=%d", userRepo.lookups, len(tokenRepo.tokens))
+				}
+			}
+			endpointHits.Lock()
+			userinfoHits, jwksHits := endpointHits.userinfo, endpointHits.jwks
+			endpointHits.Unlock()
+			if userinfoHits != 1 || jwksHits != 1 {
+				t.Fatalf("expected one UserInfo and one JWKS request, got userinfo=%d jwks=%d", userinfoHits, jwksHits)
+			}
+		})
+	}
+}
+
+func matchesPKCES256(challenge, verifier string) bool {
+	digest := sha256.Sum256([]byte(verifier))
+	return verifier != "" && challenge == base64.RawURLEncoding.EncodeToString(digest[:])
+}
