@@ -0,0 +1,43 @@
+/**
+ * CNZ uses the business workbench as the primary product surface. WeKnora
+ * remains the knowledge administration service, so generic agent, automation,
+ * artifact, toolbox, organization and standalone chat pages are hidden here.
+ * Backend authorization remains authoritative; this only scopes the CNZ UI.
+ */
+export const CNZ_ALLOWED_MENU_PATHS = new Set(['knowledge-bases', 'settings', 'logout'])
+
+export const CNZ_ALLOWED_ROUTE_NAMES = new Set([
+  'login',
+  'registerByInvite',
+  'workspaceOnboarding',
+  'knowledgeBaseList',
+  'knowledgeBaseDetail',
+  'settings',
+  'systemSettings',
+  'systemAdmins',
+])
+
+export const CNZ_ALLOWED_SETTING_SECTIONS = new Set([
+  'models',
+  'parser',
+  'system',
+  'system-global',
+  'model-catalog',
+  'runtime-queues',
+  'system-audit-log',
+  'userprofile',
+  'tenant',
+  'members',
+])
+
+export function isCnzFeatureMenuPathEnabled(path: string): boolean {
+  return CNZ_ALLOWED_MENU_PATHS.has(path)
+}
+
+export function isCnzFeatureRouteEnabled(routeName: unknown): boolean {
+  return typeof routeName === 'string' && CNZ_ALLOWED_ROUTE_NAMES.has(routeName)
+}
+
+export function isCnzFeatureSettingSectionEnabled(section: string): boolean {
+  return CNZ_ALLOWED_SETTING_SECTIONS.has(section)
+}
