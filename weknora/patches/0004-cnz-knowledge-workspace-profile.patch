@@ -0,0 +1,40 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import {
+  isCnzFeatureMenuPathEnabled,
+  isCnzFeatureRouteEnabled,
+  isCnzFeatureSettingSectionEnabled,
+} from './cnzFeatureProfile'
+
+test('CNZ navigation keeps knowledge administration and account settings', () => {
+  assert.equal(isCnzFeatureMenuPathEnabled('knowledge-bases'), true)
+  assert.equal(isCnzFeatureMenuPathEnabled('settings'), true)
+  assert.equal(isCnzFeatureMenuPathEnabled('logout'), true)
+})
+
+test('CNZ navigation hides generic platform modules', () => {
+  for (const path of ['creatChat', 'artifacts', 'agents', 'automations', 'toolbox', 'organizations']) {
+    assert.equal(isCnzFeatureMenuPathEnabled(path), false, path)
+  }
+})
+
+test('CNZ route filter preserves login and knowledge administration only', () => {
+  for (const route of ['login', 'registerByInvite', 'workspaceOnboarding', 'knowledgeBaseList', 'knowledgeBaseDetail', 'settings', 'systemSettings', 'systemAdmins']) {
+    assert.equal(isCnzFeatureRouteEnabled(route), true, route)
+  }
+  for (const route of ['globalCreatChat', 'kbCreatChat', 'artifactLibrary', 'agentList', 'automationList', 'toolbox', 'organizationList', undefined]) {
+    assert.equal(isCnzFeatureRouteEnabled(route), false, String(route))
+  }
+})
+
+test('CNZ settings keep model, parser, workspace and system operations', () => {
+  for (const section of ['models', 'parser', 'system', 'system-global', 'model-catalog', 'runtime-queues', 'system-audit-log', 'userprofile', 'tenant', 'members']) {
+    assert.equal(isCnzFeatureSettingSectionEnabled(section), true, section)
+  }
+})
+
+test('CNZ settings hide unrelated extensions and reject direct links', () => {
+  for (const section of ['ollama', 'weknoracloud', 'websearch', 'chathistory', 'defaults', 'memory', 'vectorstore', 'storage', 'sandbox', 'platform-api-keys', 'assistant', 'envvars', 'credentialvault', 'integrations.api', 'unknown']) {
+    assert.equal(isCnzFeatureSettingSectionEnabled(section), false, section)
+  }
+})
