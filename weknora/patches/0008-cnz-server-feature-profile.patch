diff --git a/internal/router/routes_chat.go b/internal/router/routes_chat.go
index d73dfd6..91a3de4 100644
--- a/internal/router/routes_chat.go
+++ b/internal/router/routes_chat.go
@@ -158,7 +158,14 @@ func RegisterChatRoutes(r *gin.RouterGroup, handler *session.Handler, g *rbacGua
 		agentChat.POST("/:session_id", handler.AgentQA)
 	}
 
-	// 新增知识检索接口，不需要session_id
+	RegisterKnowledgeSearchRoutes(r, handler, g)
+}
+
+// RegisterKnowledgeSearchRoutes registers the stateless retrieval API used by
+// the CNZ business workbench. It is intentionally separate from interactive
+// chat and agent routes so a knowledge-only deployment can keep retrieval
+// without exposing session-based generation surfaces.
+func RegisterKnowledgeSearchRoutes(r *gin.RouterGroup, handler *session.Handler, g *rbacGuards) {
 	knowledgeSearch := g.apiKeyGroup(r.Group("/knowledge-search", g.Viewer()), apiKeyRetrieve(apiKeyFullAccess()))
 	{
 		knowledgeSearch.POST("", handler.SearchKnowledge)
