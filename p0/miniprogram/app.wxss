page { background: #f5f7fa; color: #172033; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; font-size: 28rpx; }
view, text, button, input, textarea { box-sizing: border-box; }
button::after { border: 0; }
.page { padding: 28rpx 28rpx 48rpx; }
.demo-banner { background: #fff4df; border: 1rpx solid #f5d89e; border-radius: 16rpx; color: #805314; font-size: 23rpx; line-height: 1.55; padding: 18rpx 20rpx; margin-bottom: 24rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 8rpx 28rpx rgba(20, 40, 80, .045); }
.title { font-size: 38rpx; font-weight: 700; line-height: 1.35; }
.subtitle { color: #7b8494; font-size: 24rpx; line-height: 1.6; margin-top: 10rpx; }
.section-title { font-size: 30rpx; font-weight: 650; margin: 30rpx 0 18rpx; }
.primary { background: #1769e0; border-radius: 14rpx; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 1.4; padding: 22rpx; }
.secondary { background: #edf4ff; border-radius: 14rpx; color: #1769e0; font-size: 26rpx; padding: 20rpx; }
.muted { color: #8791a1; font-size: 24rpx; }
.row { align-items: center; display: flex; justify-content: space-between; }
.pill { background: #eef4ff; border-radius: 999rpx; color: #1769e0; font-size: 22rpx; padding: 8rpx 16rpx; }
.field { border-bottom: 1rpx solid #edf0f4; padding: 22rpx 0; }
.field-label { color: #475166; display: block; font-size: 25rpx; margin-bottom: 14rpx; }
.input, .textarea { color: #172033; font-size: 27rpx; width: 100%; }
.textarea { min-height: 150rpx; }
.item { border-bottom: 1rpx solid #f0f2f5; padding: 22rpx 0; }
.empty { color: #8791a1; line-height: 1.7; padding: 34rpx 8rpx; text-align: center; }
.link { color: #1769e0; }
.chat-list { display: flex; flex-direction: column; gap: 18rpx; padding: 18rpx 0 28rpx; }
.bubble { background: #fff; border-radius: 18rpx 18rpx 18rpx 4rpx; line-height: 1.55; max-width: 82%; padding: 18rpx 20rpx; }
.bubble.mine { align-self: flex-end; background: #1769e0; border-radius: 18rpx 18rpx 4rpx 18rpx; color: #fff; }
.quick-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0; }
.quick { background: #edf4ff; border-radius: 999rpx; color: #1769e0; font-size: 23rpx; padding: 12rpx 18rpx; }
