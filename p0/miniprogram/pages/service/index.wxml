<view class="page">
  <view class="demo-banner">{{apiEnabled ? '本地客服服务演示 · 消息写入隔离演示服务，不会发送给微信客服或通知真实人员。' : '离线客服演示 · 对话只存于本机，不会发送、存档或通知任何客服人员。'}}</view>
  <view wx:if="{{serviceError}}" class="card empty">{{serviceError}}；消息没有回退为本机“已发送”。</view>
  <button wx:if="{{pendingBlocked || pendingClearedNeedsCheck}}" class="secondary" bindtap="discardPending">{{pendingClearedNeedsCheck ? '我已核对会话记录，继续' : (pendingUnreadable ? '清理不可读的待确认消息' : '清除旧账号待确认消息')}}</button>
  <view class="card"><view class="title">客服咨询</view><view class="subtitle">{{apiEnabled ? '消息仅存入本地演示服务；管理员可在演示工作台回复。不会自动回复或触发微信客服、企微及真实通知。' : '快捷问题会返回固定的离线指引；手动输入只保存到本机，不会自动回复。'}}</view><button wx:if="{{apiEnabled}}" class="secondary" style="margin-top:12rpx" bindtap="refresh">刷新会话</button></view>
  <view class="quick-row">
    <text class="quick" data-question="我想咨询检测项目和能力范围" bindtap="chooseQuestion">检测能力</text>
    <text class="quick" data-question="我想咨询检测周期" bindtap="chooseQuestion">检测周期</text>
    <text class="quick" data-question="我想咨询委托流程" bindtap="chooseQuestion">委托流程</text>
  </view>
  <view class="chat-list"><view wx:for="{{messages}}" wx:key="id" class="bubble {{item.side === 'user' ? 'mine' : ''}}">{{item.text}}</view></view>
  <view class="card"><textarea class="textarea" style="min-height:96rpx" value="{{draft}}" bindinput="onInput" placeholder="输入一条演示消息" /><button class="primary" style="margin-top:16rpx" loading="{{sending}}" disabled="{{sending}}" bindtap="send">{{apiEnabled ? '提交到演示队列' : '保存到本机'}}</button></view>
</view>
